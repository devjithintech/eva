# ── LightHouse agent server ───────────────────────────────────────────────
# Copy to .env and fill in the keys for whichever providers you want enabled.
# With NO keys set, the server runs the deterministic "mock" provider so the
# app works end-to-end out of the box (mirrors the original scripted demo).

PORT=8787

# Default model the agent uses when the client doesn't specify one.
# Must be one of the ids in src/llm/registry.ts (e.g. gemini-2.0-flash).
DEFAULT_MODEL=gemini-2.0-flash

# Google Gemini  → https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (optional) → https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (optional) → https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq (optional, free + fast) → https://console.groq.com/keys
# Great for testing when other providers' free quotas are exhausted.
# To make Groq the default model, set DEFAULT_MODEL=groq-llama-3.3-70b above.
GROQ_API_KEY=

# Microsoft (Azure AI) Foundry serving Claude (optional).
# Anthropic-compatible "/anthropic/" passthrough. Set DEFAULT_MODEL=foundry-claude
# above to make it the default. The same key + resource also powers voice
# transcription (below).
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=claude-sonnet-4-6

# ── Voice / STT (speech-to-text) ────────────────────────────────────────────
# Voice input via Azure Foundry Whisper — reuses FOUNDRY_API_KEY. With no
# Whisper deployment, the browser's Web Speech API is used as a fallback.
# FOUNDRY_TRANSCRIBE_MODEL is the Azure *deployment* name of your Whisper model.
# The transcription URL is derived from FOUNDRY_ENDPOINT by default; set
# FOUNDRY_TRANSCRIBE_ENDPOINT to a full URL to override it.
FOUNDRY_TRANSCRIBE_MODEL=whisper
# FOUNDRY_TRANSCRIBE_ENDPOINT=

# ── Voice / TTS (text-to-speech) ────────────────────────────────────────────
# Speech-to-text uses the browser (free, no key). Text-to-speech is server-side.
# Default uses Groq Orpheus TTS on the free tier (reuses GROQ_API_KEY) — but you
# must accept the model terms ONCE at:
#   https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
# until then calls 400 and the app uses the browser's speechSynthesis fallback.
TTS_PROVIDER=groq                 # groq | elevenlabs
TTS_VOICE=tara                    # Orpheus voice: tara, leah, jess, leo, dan, mia, zac, zoe

# Premium upgrade (optional) → https://elevenlabs.io
# Set the key and TTS_PROVIDER=elevenlabs for the most natural, Sesame-like voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
