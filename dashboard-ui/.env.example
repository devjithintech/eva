# Copy to .env.local and adjust as needed (all optional — defaults shown).

# BFF base URL. Default "/api" (proxied to the agent server in dev — see vite.config.ts).
#VITE_API_URL=/api

# Renderers service base URL — serves the D1-x renderer endpoints (/renderers/*)
# used by the Candidate Analytics / Peer Fit page.
#VITE_RENDERERS_URL=http://127.0.0.1:8765

# Valuation date sent as `as_of_date` on every renderer call.
#VITE_RENDERERS_AS_OF=2026-04-30

# Last-resort fund key (`fund_id`) for renderer calls. Fund ids are dynamic —
# taken from the selected candidate's record (subject_fund.analytics_fund_id,
# else subject_fund.fund_id); this is only used when a record has neither.
#VITE_RENDERERS_FUND_ID=C-2026-001::alpha

# URL of the conversational (LightAssist chat) app the dashboard links back to as "Home".
#VITE_CONVERSATION_URL=http://localhost:5173
